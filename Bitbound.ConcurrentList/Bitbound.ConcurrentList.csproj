<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <PackageId>Bitbound.ConcurrentList</PackageId>
    <Authors>Jared Goodwin</Authors>
    <Description>A simple, lock-based implementation of a thread-safe list.</Description>
    <Copyright>© 2025 Jared Goodwin</Copyright>
    <RepositoryUrl>https://github.com/bitbound/ConcurrentList</RepositoryUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/bitbound/ConcurrentList</PackageProjectUrl>
    <PackageIcon>bitbound.png</PackageIcon>
    <Version>1.0.0</Version>
    <Title>ConcurrentList</Title>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <SignAssembly>False</SignAssembly>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\.assets\bitbound.png">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
    <None Include="..\README.md">
      <Pack>True</Pack>
      <PackagePath>\</PackagePath>
    </None>
  </ItemGroup>

</Project>
